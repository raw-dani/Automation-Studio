{
  "id": "workflow_login_otp",
  "name": "Login dengan OTP",
  "version": "1.0",
  "url": "https://skb.atrbpn.go.id/",
  "data_source": {
    "type": "none",
    "config": {}
  },
  "steps": [
    {
      "id": "step_1",
      "type": "navigate",
      "label": "Buka halaman login",
      "params": {
        "url": "https://skb.atrbpn.go.id/",
        "wait_until": "domcontentloaded",
        "timeout": 30000
      },
      "on_error": "stop",
      "retry": {
        "max_retries": 3,
        "delay": 2000
      }
    },
    {
      "id": "step_2",
      "type": "login_otp",
      "label": "Login dengan OTP",
      "params": {
        "username_selector": "#username",
        "username_value": "{{data.USERNAME}}",
        "password_selector": "#password",
        "password_value": "{{data.PASSWORD}}",
        "login_selector": "#btn-login",
        "login_wait_until": "domcontentloaded",
        "otp_selector": "#otp-input",
        "otp_submit_selector": "#btn-verify",
        "check_selector": "#dashboard-welcome",
        "timeout": 30000,
        "wait_for_otp_timeout": 120000,
        "otp_length": 6,
        "otp_title": "Masukkan Kode OTP",
        "otp_description": "Cek SMS/email Anda dan masukkan 6 digit kode OTP",
        "otp_auto_submit": true
      },
      "on_error": "stop",
      "retry": {
        "max_retries": 3,
        "delay": 2000
      }
    }
  ],
  "monitoring": {
    "screenshot_on_error": true,
    "screenshot_on_step": false,
    "log_level": "INFO"
  },
  "created_at": "2026-08-22T20:46:12+07:00",
  "updated_at": "2026-08-22T20:46:12+07:00"
}

            "wait_before": 0,
            "wait_after": 0
          },
          "on_error": "stop",
          "retry": {
            "max_retries": 3,
            "delay": 2000
          }
        },
        {
          "id": "step_9d",
          "type": "input_text",
          "label": "Input Lokasi",
          "params": {
            "selector": "#tLOKASI",
            "value": "{{data.TEMPAT LAHIR}}",
            "clear_first": true,
            "use_fill": true,
            "wait_before": 0,
            "wait_after": 0
          },
          "on_error": "stop",
          "retry": {
            "max_retries": 3,
            "delay": 2000
          }
        },
        {
          "id": "step_9e",
          "type": "input_text",
          "label": "Input Tempat Lahir",
          "params": {
            "selector": "#tTEMPAT_LAHIR",
            "value": "{{data.TEMPAT LAHIR}}",
            "clear_first": true,
            "use_fill": true,
            "wait_before": 0,
            "wait_after": 0
          },
          "on_error": "stop",
          "retry": {
            "max_retries": 3,
            "delay": 2000
          }
        },
        {
          "id": "step_9f",
          "type": "input_text",
          "label": "Input Status Kawin",
          "params": {
            "selector": "#tSTATUS_KAWIN",
            "value": "{{data.STATUS}}",
            "clear_first": true,
            "use_fill": true,
            "wait_before": 0,
            "wait_after": 0
          },
          "on_error": "stop",
          "retry": {
            "max_retries": 3,
            "delay": 2000
          }
        }
      ]
    },
    {
      "id": "step_10",
      "type": "wait",
      "label": "Wait sebelum submit",
      "params": {
        "wait_type": "fixed",
        "duration": 1000
      },
      "on_error": "stop",
      "retry": {
        "max_retries": 3,
        "delay": 2000
      }
    },
        {
          "id": "step_11",
          "type": "click",
          "label": "Klik tombol Tambah (Simpan Pemilik)",
          "params": {
            "selector": "#btn-tambah",
            "selector_type": "css",
            "force": true,
            "timeout": 5000,
            "wait_for_load_state": "none",
            "wait_after": 500
          },
      "on_error": "stop",
      "retry": {
        "max_retries": 3,
        "delay": 2000
      }
    },
    {
      "id": "step_12",
      "type": "wait",
      "label": "Wait loading selesai",
      "params": {
        "wait_type": "until_hidden",
        "selector": ".loading, .spinner",
        "timeout": 10000
      },
      "on_error": "stop",
      "retry": {
        "max_retries": 3,
        "delay": 2000
      }
    },
    {
      "id": "step_13",
      "type": "navigate",
      "label": "Buka ulang halaman Berkas Saya",
      "params": {
        "url": "https://skb.atrbpn.go.id/BerkasSaya#",
        "wait_until": "domcontentloaded",
        "timeout": 30000
      },
      "on_error": "stop",
      "retry": {
        "max_retries": 3,
        "delay": 2000
      }
    }
  ],
  "monitoring": {

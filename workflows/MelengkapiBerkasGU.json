  "steps": [
    {
      "id": "step_1",
      "type": "wait",
      "label": "Wait browser/page siap",
      "params": {
        "wait_type": "until_visible",
        "selector": "body",
        "timeout": 60000
      },
      "on_error": "stop",
      "retry": {
        "max_retries": 3,
        "delay": 2000
      }
    },
    {
      "id": "step_2",
      "type": "wait",
      "label": "Tunggu proses login selesai",
      "params": {
        "duration": 300,
        "timeout": 10000,
        "wait_type": "fixed"
      },
      "on_error": "stop",
      "retry": {
        "max_retries": 3,
        "delay": 2000
      }
    },
    {

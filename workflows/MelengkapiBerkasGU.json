{
  "id": "workflow_isi_data_pemilik_gu1",
  "name": "Isi Data Pemilik - LAYOUT GU 51",
  "version": "3.0",
  "url": "https://skb.atrbpn.go.id/BerkasSaya#",
  "data_source": {
    "config": {
      "file_path": "data/51. LAYOUT MELENGKAPI BERKAS GU 51.xlsx",
      "sheet": "Sheet1"
    },
    "type": "excel"
  },
  "steps": [
    {
      "id": "step_1",
      "type": "wait",
      "label": "Wait browser/page siap",
      "params": {
        "wait_type": "until_visible",
        "selector": "body",
        "timeout": 60000
      },
      "on_error": "stop",
      "retry": {
        "max_retries": 3,
        "delay": 2000
      }
    },
    {
      "id": "step_2",
      "type": "wait",
      "label": "Tunggu proses login selesai",
      "params": {
        "wait_type": "fixed",
        "duration": 3000,
        "timeout": 10000
      },
      "on_error": "stop",
      "retry": {
        "max_retries": 3,
        "delay": 2000
      }
    },
    {
      "id": "step_3",
      "type": "loop",
      "label": "Loop setiap baris pemilik",
      "params": {
        "loop_type": "data_source",
        "data_source": "pemilik"
      },
      "on_error": "skip",
      "retry": {
        "max_retries": 3,
        "delay": 2000
      }
    },
    {
      "id": "step_4",
      "type": "click",
      "label": "Klik tab Entri Berkas",
      "params": {
        "selector": "#profile-tab",
        "selector_type": "css",
        "force": true,
        "timeout": 5000,
        "wait_for_load_state": "none"
      },
      "on_error": "stop",
      "retry": {
        "max_retries": 3,
        "delay": 2000
      }
    },
    {
      "id": "step_5",
      "type": "wait",
      "label": "Tunggu form Entri Berkas siap",
      "params": {
        "wait_type": "until_visible",
        "selector": "#inputpemohonplaceholder",
        "timeout": 10000
      },
      "on_error": "stop",
      "retry": {
        "max_retries": 3,
        "delay": 2000
      }
    },
    {
      "id": "step_6",
      "type": "click",
      "label": "Buka dropdown tipe pemilik",
      "params": {
        "selector": "#lblTipe",
        "selector_type": "css",
        "force": true,
        "timeout": 5000,
        "wait_for_load_state": "none"
      },
      "on_error": "stop",
      "retry": {
        "max_retries": 3,
        "delay": 2000
      }
    },
    {
      "id": "step_7",
      "type": "click",
      "label": "Pilih Perorangan tanpa cek NIK",
      "params": {
        "selector": "//a[contains(@onclick, \"ShowInputPemohon(5)\")]",
        "selector_type": "xpath",
        "force": true,
        "timeout": 5000,
        "wait_for_load_state": "none"
      },
      "on_error": "stop",
      "retry": {
        "max_retries": 3,
        "delay": 2000
      }
    },
    {
      "id": "step_8",
      "type": "wait",
      "label": "Tunggu form pemilik NonDukcapil",
      "params": {
        "wait_type": "until_visible",
        "selector": "#frmPemohonNonDukcapil",
        "timeout": 10000
      },
      "on_error": "stop",
      "retry": {
        "max_retries": 3,
        "delay": 2000
      }
    },
    {
      "id": "step_9",
      "type": "parallel_group",
      "label": "Isi semua field form pemilik",
      "params": {
        "timeout": 30000,
        "on_error": "skip"
      },
      "on_error": "stop",
      "retry": {
        "max_retries": 3,
        "delay": 2000
      },
      "steps": [
        {
          "id": "step_9a",
          "type": "input_text",
          "label": "Input NIK",
          "params": {
            "selector": "#tNIK",
            "value": "{{data.NIK}}",
            "clear_first": true,
            "use_fill": true,
            "wait_before": 0,
            "wait_after": 0

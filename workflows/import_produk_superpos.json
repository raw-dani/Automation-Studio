{
  "id": "workflow_739e8c09",
  "name": "My Workflow (Optimized)",
  "version": "2.0",
  "description": "Import produk dengan parallel group execution untuk performa lebih cepat",
  "url": "https://skb.atrbpn.go.id",
  "data_source": {
    "config": {
      "file_path": "data/Dummy_Import_Produk (1).xlsx",
      "sheet": "Sheet"
    },
    "type": "excel"
  },
  "monitoring": {
    "screenshot_on_error": true,
    "screenshot_on_step": false,
    "log_level": "INFO"
  },
  "steps": [
    {
      "id": "step_1",
      "type": "wait",
      "label": "Wait halaman login siap",
      "params": {
        "selector": "body",
        "timeout": 15,
        "wait_type": "until_visible"
      },
      "on_error": "stop",
      "retry": {
        "max_retries": 3,
        "delay": 2000
      }
    },
    {
      "id": "step_login_group",
      "type": "parallel_group",
      "label": "Isi Username & Password bersamaan",
      "params": {
        "timeout": 30000,
        "on_error": "stop"
      },
      "steps": [
        {
          "id": "step_2",
          "type": "input_text",
          "label": "Username",
          "params": {
            "clear_first": true,
            "selector": "#username, input[name='username'], input[type='email']",
            "value": "nurulkhabibatul",
            "use_fill": true,
            "wait_before": 0,
            "wait_after": 0
          },
          "on_error": "stop",
          "retry": {
            "max_retries": 3,
            "delay": 2000
          }
        },
        {
          "id": "step_3",
          "type": "input_text",
          "label": "Password",
          "params": {
            "clear_first": true,
            "selector": "#password, input[name='password'], input[type='password']",
            "value": "Bibah123",
            "use_fill": true,
            "wait_before": 0,
            "wait_after": 0
          },
          "on_error": "stop",
          "retry": {
            "max_retries": 3,
            "delay": 2000
          }
        }
      ]
    },
    {
      "id": "step_4",
      "type": "click",
      "label": "Klik tombol Login",
      "params": {
        "selector": "#kc-next",
        "wait_before": 500
      },
      "on_error": "stop",
      "retry": {
        "max_retries": 3,
        "delay": 2000
      }
    },
    {
      "id": "step_5",
      "type": "wait",
      "label": "Wait setelah login berhasil",
      "params": {
        "selector": "body > div.tour-backdrop.bottom",
        "timeout": 15000,
        "wait_type": "until_hidden"
      },
      "on_error": "stop",
      "retry": {
        "max_retries": 3,
        "delay": 2000
      }
    },
    {
      "id": "step_7",
      "type": "click",
      "label": "Navigasi ke menu Produk",
      "params": {
        "selector": "#tour_step5 > svg.svg.tw-ml-auto.tw-text-gray-500.tw-size-4.tw-shrink-0",
        "wait_before": 500
      },
      "on_error": "stop",
      "retry": {
        "max_retries": 3,
        "delay": 2000
      }
    },
    {
      "id": "step_9",
      "type": "click",
      "label": "Klik tombol Tambah Produk",
      "params": {
        "selector": "#side-bar > div:nth-child(4) > div > div.tw-space-y-3\\.5 > a:nth-child(2)",
        "wait_before": 500
      },
      "on_error": "stop",
      "retry": {
        "max_retries": 3,
        "delay": 2000
      }
    },
    {
      "id": "step_8",
      "type": "wait",
      "label": "Wait halaman produk dimuat",
      "params": {
        "selector": "#product_add_form",
        "timeout": 10000,
        "wait_type": "until_visible"
      },
      "on_error": "stop",
      "retry": {
        "max_retries": 3,
        "delay": 2000
      }
    },
    {
      "id": "step_10",
      "type": "loop",
      "label": "Loop setiap produk dari Excel",
      "params": {
        "loop_type": "data_source"
      },
      "on_error": "stop",
      "retry": {
        "max_retries": 3,
        "delay": 2000
      }
    },
    {
      "id": "step_form_group",
      "type": "parallel_group",
      "label": "Isi semua field produk secara bersamaan",
      "params": {
        "timeout": 30000,
        "on_error": "skip"
      },
      "steps": [
        {
          "id": "step_11",
          "type": "input_text",
          "label": "Input Nama Produk",
          "params": {
            "selector": "#name, input[name='name']",
            "value": "{{data.Nama Produk}}",
            "clear_first": true,
            "skip_if_empty": true,
            "use_fill": true,
            "wait_before": 0,
            "wait_after": 0
          },
          "on_error": "skip",
          "retry": {
            "max_retries": 3,
            "delay": 2000
          }
        },
        {
          "id": "step_12",
          "type": "select2",
          "label": "Pilih Jenis Barcode",
          "params": {
            "selector": "#barcode_type",
            "value": "{{data.Jenis Barcode}}",
            "add_new": false,
            "skip_if_empty": true,
            "wait_before": 0,
            "wait_after": 0
          },
          "on_error": "skip",
          "retry": {
            "max_retries": 3,
            "delay": 2000
          }
        },
        {
          "id": "step_13",
          "type": "input_text",
          "label": "Input SKU",
          "params": {
            "selector": "#sku",
            "value": "{{data.SKU}}",
            "clear_first": true,
            "skip_if_empty": true,
            "use_fill": true,
            "wait_before": 0,
            "wait_after": 0
          },
          "on_error": "skip",
          "retry": {
            "max_retries": 3,
            "delay": 2000
          }
        },
        {
          "id": "step_14",
          "type": "select2",
          "label": "Pilih Merek",
          "params": {
            "selector": "#brand_id",
            "value": "{{data.Merek}}",
            "add_new": true,
            "skip_if_empty": true,
            "wait_before": 0,
            "wait_after": 0
          },
          "on_error": "skip",
          "retry": {
            "max_retries": 3,
            "delay": 2000
          }
        },
        {
          "id": "step_15",
          "type": "select2",
          "label": "Pilih Kategori",
          "params": {
            "selector": "#category_id",
            "value": "{{data.Kategori}}",
            "add_new": true,
            "skip_if_empty": true,
            "wait_before": 0,
            "wait_after": 0
          },
          "on_error": "skip",
          "retry": {
            "max_retries": 3,
            "delay": 2000
          }
        },
        {
          "id": "step_16",
          "type": "select2",
          "label": "Pilih Unit",
          "params": {
            "selector": "#unit_id",
            "value": "{{data.Unit}}",
            "add_new": true,
            "skip_if_empty": true,
            "wait_before": 0,
            "wait_after": 0
          },
          "on_error": "skip",
          "retry": {
            "max_retries": 3,
            "delay": 2000
          }
        },
        {
          "id": "step_17",
          "type": "input_text",
          "label": "Input Harga Pembelian",
          "params": {
            "selector": "#single_dpp, #single_dpp_inc_tax",
            "value": "{{data.Harga Pembelian (Termasuk Pajak)}}",
            "clear_first": true,
            "skip_if_empty": true,
            "use_fill": true,
            "wait_before": 0,
            "wait_after": 0
          },
          "on_error": "skip",
          "retry": {
            "max_retries": 3,
            "delay": 2000
          }
        },
        {
          "id": "step_18",
          "type": "input_text",
          "label": "Input Harga Jual",
          "params": {
            "selector": "#single_dsp, #single_dsp_inc_tax",
            "value": "{{data.Harga penjualan}}",
            "clear_first": true,
            "skip_if_empty": true,
            "use_fill": true,
            "wait_before": 0,
            "wait_after": 0
          },
          "on_error": "skip",
          "retry": {
            "max_retries": 3,
            "delay": 2000
          }
        },
        {
          "id": "step_20",
          "type": "input_text",
          "label": "Input Berat",
          "params": {
            "selector": "#weight",
            "value": "{{data.Berat}}",
            "clear_first": true,
            "skip_if_empty": true,
            "use_fill": true,
            "wait_before": 0,
            "wait_after": 0
          },
          "on_error": "skip",
          "retry": {
            "max_retries": 3,
            "delay": 2000
          }
        },
        {
          "id": "step_21",
          "type": "input_text",
          "label": "Input Deskripsi Produk",
          "params": {
            "selector": "#product_description, textarea[name='product_description']",
            "value": "{{data.Deskripsi Produk}}",
            "clear_first": true,
            "skip_if_empty": true,
            "use_fill": true,
            "wait_before": 0,
            "wait_after": 0
          },
          "on_error": "skip",
          "retry": {
            "max_retries": 3,
            "delay": 2000
          }
        }
      ]
    },
    {
      "id": "step_22",
      "type": "wait",
      "label": "Wait sebelum submit",
      "params": {
        "wait_type": "fixed",
        "duration": 500
      },
      "on_error": "stop",
      "retry": {
        "max_retries": 3,
        "delay": 2000
      }
    },
    {
      "id": "step_23",
      "type": "click",
      "label": "Klik tombol Simpan Produk",
      "params": {
        "selector": ".submit_product_form",
        "wait_before": 0
      },
      "on_error": "stop",
      "retry": {
        "max_retries": 3,
        "delay": 2000
      }
    },
    {
      "id": "step_24",
      "type": "wait",
      "label": "Wait loading/notification selesai",
      "params": {
        "wait_type": "until_hidden",
        "selector": ".loading, .spinner, .modal-backdrop",
        "timeout": 10000
      },
      "on_error": "stop",
      "retry": {
        "max_retries": 3,
        "delay": 2000
      }
    }
  ]
}
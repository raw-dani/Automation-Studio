{
  "id": "workflow_isi_data_pemilik_gu1",
  "name": "Isi Data Pemilik - LAYOUT GU 1 (Optimized)",
  "version": "2.0",
  "description": "Workflow untuk mengisi data pemilik/hak dari file LAYOUT MELENGKAPI BERKAS GU 1.xlsx - Dengan parallel group execution untuk performa lebih cepat",
  "data_source": {
    "type": "excel",
    "config": {
      "file_path": "data/LAYOUT MELENGKAPI BERKAS GU 1.xlsx",
      "sheet": "Sheet1"
    }
  },
  "monitoring": {
    "screenshot_on_error": true,
    "screenshot_on_step": false,
    "log_level": "INFO"
  },
  "steps": [
    {
      "id": "step_1",
      "type": "wait",
      "label": "Wait browser/page siap",
      "params": {
        "wait_type": "until_visible",
        "selector": "body",
        "timeout": 15000
      }
    },
    {
      "id": "step_2",
      "type": "loop",
      "label": "Loop setiap baris pemilik",
      "params": {
        "loop_type": "data_source",
        "data_source": "pemilik"
      },
      "on_error": "skip",
      "retry": {"max_retries": 2, "delay": 2000}
    },
    {
      "id": "step_3",
      "type": "wait",
      "label": "Wait sebelum input",
      "params": {"wait_type": "fixed", "duration": 1500}
    },
    {
      "id": "step_4",
      "type": "click",
      "label": "Klik tombol Tambah/Baru",
      "params": {
        "selector": "#btn-tambah",
        "wait_before": 500
      }
    },
    {
      "id": "step_5",
      "type": "parallel_group",
      "label": "Isi semua field form secara bersamaan",
      "params": {
        "timeout": 30000,
        "on_error": "skip"
      },
      "steps": [
        {
          "id": "step_5a",
          "type": "input_text",
          "label": "Input Nama Pemilik",
          "params": {
            "selector": "#nama",
            "value": "{{data.NAMA}}",
            "clear_first": true,
            "use_fill": true,
            "wait_before": 0,
            "wait_after": 0
          }
        },
        {
          "id": "step_5b",
          "type": "input_text",
          "label": "Input NIK",
          "params": {
            "selector": "#nik",
            "value": "{{data.NIK}}",
            "clear_first": true,
            "use_fill": true,
            "wait_before": 0,
            "wait_after": 0
          }
        },
        {
          "id": "step_5c",
          "type": "input_text",
          "label": "Input Alamat",
          "params": {
            "selector": "#alamat",
            "value": "{{data.ALAMAT}}",
            "clear_first": true,
            "use_fill": true,
            "wait_before": 0,
            "wait_after": 0
          }
        },
        {
          "id": "step_5d",
          "type": "input_text",
          "label": "Input Tempat Lahir",
          "params": {
            "selector": "#tempat_lahir",
            "value": "{{data.TEMPAT LAHIR}}",
            "clear_first": true,
            "use_fill": true,
            "wait_before": 0,
            "wait_after": 0
          }
        },
        {
          "id": "step_5e",
          "type": "select_dropdown",
          "label": "Pilih Status Pemilik",
          "params": {
            "selector": "#status",
            "select_by": "label",
            "select_value": "{{data.STATUS}}",
            "wait_before": 0,
            "wait_after": 0
          }
        }
      ]
    },
    {
      "id": "step_6",
      "type": "wait",
      "label": "Wait sebelum submit",
      "params": {"wait_type": "fixed", "duration": 1000}
    },
    {
      "id": "step_7",
      "type": "click",
      "label": "Klik tombol Simpan",
      "params": {
        "selector": "#btn-simpan",
        "wait_before": 0,
        "wait_after": 500
      }
    },
    {
      "id": "step_8",
      "type": "wait",
      "label": "Wait loading selesai",
      "params": {
        "wait_type": "until_hidden",
        "selector": ".loading, .spinner",
        "timeout": 10000
      }
    }
  ]
}
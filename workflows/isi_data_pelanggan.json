{
  "id": "workflow_386063e8",
  "name": "My Workflow",
  "version": "1.0",
  "url": "",
  "data_source": {
    "config": {
      "file_path": "data/pelanggan demo.xlsx",
      "sheet": "Sheet1"
    },
    "type": "excel"
  },
  "steps": [
    {
      "id": "step_1",
      "type": "wait",
      "label": "Wait halaman siap",
      "params": {
        "wait_type": "until_visible",
        "selector": "body",
        "timeout": 15000
      },
      "on_error": "stop",
      "retry": {
        "max_retries": 3,
        "delay": 2000
      }
    },
    {
      "id": "step_2",
      "type": "navigate",
      "label": "Buka menu Pelanggan / Kontak",
      "params": {
        "selector": "#menu-pelanggan, a[href*='contact'], .nav-contact",
        "url": "http://superpos.local/public/contacts?type=customer",
        "wait_before": 1000
      },
      "on_error": "stop",
      "retry": {
        "max_retries": 3,
        "delay": 2000
      }
    },
    {
      "id": "step_5",
      "type": "loop",
      "label": "Loop setiap baris data pelanggan dari Excel",
      "params": {
        "loop_type": "data_source",
        "data_source": "pelanggan",
        "on_error": "skip"
      },
      "on_error": "skip",
      "retry": {
        "max_retries": 3,
        "delay": 2000
      },
      "steps": [
        {
          "id": "step_3",
          "type": "click",
          "label": "Klik tombol Tambah Pelanggan Baru",
          "params": {
            "selector": ".btn-modal",
            "selector_type": "css",
            "timeout": 10000,
            "wait_after": 0,
            "wait_before": 100
          },
          "on_error": "skip",
          "retry": {
            "max_retries": 3,
            "delay": 2000
          }
        },
        {
          "id": "step_4",
          "type": "wait",
          "label": "Wait form pelanggan dimuat",
          "params": {
            "duration": 1000,
            "selector": "#form-pelanggan, .contact-form, #contact_add_form",
            "timeout": 10000,
            "wait_after": 0,
            "wait_before": 0,
            "wait_type": "until_visible"
          },
          "on_error": "skip",
          "retry": {
            "max_retries": 3,
            "delay": 2000
          }
        },
        {
          "id": "step_form_group",
          "type": "parallel_group",
          "label": "Isi semua field pelanggan secara bersamaan",
          "params": {
            "on_error": "stop",
            "timeout": 8000,
            "stagger_delay": 50
          },
          "on_error": "stop",
          "retry": {
            "max_retries": 3,
            "delay": 2000
          },
          "steps": [
            {
              "id": "step_6",
              "type": "select_dropdown",
              "label": "Pilih Jenis Kontak",
              "params": {
                "select_by": "label",
                "select_value": "{{data.Jenis Kontak}}",
                "selector": "#contact_type",
                "selector_type": "css",
                "timeout": 10000,
                "wait_after": 0,
                "wait_before": 0
              },
              "on_error": "skip",
              "retry": {
                "max_retries": 3,
                "delay": 2000
              }
            },
            {
              "id": "step_7",
              "type": "radio_select",
              "label": "Pilih Tipe",
              "params": {
                "select_by": "value",
                "selector": "input[name=\"contact_type_radio\"]",
                "selector_type": "css",
                "timeout": 10000,
                "value": "{{data.Tipe}}",
                "wait_after": 0,
                "wait_before": 0
              },
              "on_error": "skip",
              "retry": {
                "max_retries": 3,
                "delay": 2000
              }
            },
            {
              "id": "step_8",
              "type": "input_text",
              "label": "Input ID Kontak",
              "params": {
                "clear_first": true,
                "selector": "#contact_id",
                "selector_type": "css",
                "timeout": 10000,
                "type_delay": 50,
                "value": "{{data.ID Kontak}}",
                "wait_after": 0,
                "wait_before": 0
              },
              "on_error": "skip",
              "retry": {
                "max_retries": 3,
                "delay": 2000
              }
            },
            {
              "id": "step_9",
              "type": "select_dropdown",
              "label": "Pilih Grup Pelanggan",
              "params": {
                "select_by": "label",
                "select_value": "{{data.Grup Pelanggan}}",
                "selector": "#customer_group_id",
                "selector_type": "css",
                "timeout": 10000,
                "wait_after": 0,
                "wait_before": 0
              },
              "on_error": "skip",
              "retry": {
                "max_retries": 3,
                "delay": 2000
              }
            },
            {
              "id": "step_10",
              "type": "input_text",
              "label": "Input No. Mobile",
              "params": {
                "clear_first": true,
                "selector": "#mobile",
                "selector_type": "css",
                "timeout": 30000,
                "type_delay": 50,
                "value": "{{data.Mobile}}",
                "wait_after": 0,
                "wait_before": 0
              },
              "on_error": "skip",
              "retry": {
                "max_retries": 3,
                "delay": 2000
              }
            },
            {
              "id": "step_11",
              "type": "input_text",
              "label": "Input No. Kontak Alternatif",
              "params": {
                "clear_first": true,
                "selector": "#alternate_number",
                "selector_type": "css",
                "timeout": 30000,
                "type_delay": 50,
                "value": "{{data.Nomor Kontak Alternatif}}",
                "wait_after": 0,
                "wait_before": 0
              },
              "on_error": "skip",
              "retry": {
                "max_retries": 3,
                "delay": 2000
              }
            },
            {
              "id": "step_12",
              "type": "input_text",
              "label": "Input Telepon Rumah",
              "params": {
                "clear_first": true,
                "selector": "#landline",
                "selector_type": "css",
                "timeout": 30000,
                "type_delay": 50,
                "value": "{{data.Telepon Rumah}}",
                "wait_after": 0,
                "wait_before": 0
              },
              "on_error": "skip",
              "retry": {
                "max_retries": 3,
                "delay": 2000
              }
            },
            {
              "id": "step_13",
              "type": "input_text",
              "label": "Input Email",
              "params": {
                "clear_first": true,
                "selector": "#email",
                "selector_type": "css",
                "timeout": 30000,
                "type_delay": 50,
                "value": "{{data.Email}}",
                "wait_after": 0,
                "wait_before": 0
              },
              "on_error": "skip",
              "retry": {
                "max_retries": 3,
                "delay": 2000
              }
            },
            {
              "id": "step_14",
              "type": "select_dropdown",
              "label": "Pilih Ditugaskan Kepada",
              "params": {
                "select_by": "label",
                "select_value": "{{data.Ditugaskan Kepada}}",
                "selector": "#assigned_to_users",
                "selector_type": "css",
                "timeout": 10000,
                "wait_after": 0,
                "wait_before": 0
              },
              "on_error": "skip",
              "retry": {
                "max_retries": 3,
                "delay": 2000
              }
            }
          ]
        },
        {
          "id": "step_15",
          "type": "wait",
          "label": "Wait sebelum submit",
          "params": {
            "duration": 100,
            "timeout": 3000,
            "wait_after": 0,
            "wait_before": 0,
            "wait_type": "fixed"
          },
          "on_error": "skip",
          "retry": {
            "max_retries": 3,
            "delay": 2000
          }
        },
        {
          "id": "step_16",
          "type": "http_submit",
          "label": "Submit form pelanggan via HTTP POST",
          "params": {
            "form_selector": "#contact_add_form",
            "selector_type": "css",
            "submit_selector": "#contact_add_form > div.modal-footer > button[type='submit']",
            "wait_after": 0,
            "timeout": 10000
          },
          "on_error": "skip",
          "retry": {
            "max_retries": 3,
            "delay": 2000
          }
        },
        {
          "id": "step_17",
          "type": "wait",
          "label": "Wait notifikasi / loading selesai",
          "params": {
            "duration": 100,
            "selector": ".loading, .spinner, .modal-backdrop, .overlay",
            "timeout": 5000,
            "wait_after": 0,
            "wait_before": 0,
            "wait_type": "until_hidden"
          },
          "on_error": "skip",
          "retry": {
            "max_retries": 3,
            "delay": 2000
          }
        }
      ]
    }
  ],
  "monitoring": {
    "screenshot_on_error": true,
    "screenshot_on_step": false,
    "log_level": "INFO"
  },
  "created_at": "2026-07-26T12:16:18.349147",
  "updated_at": "2026-07-28T20:02:39.128417"
}